#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# OpenClaude Code Server add-on: persistent dirs, OpenClaude env for shells.
# ==============================================================================
set -euo pipefail

readonly PROFILE_FILE=/etc/profile.d/99-openclaude-hass.sh
readonly GIT_USER_PATH=/data/git

mkdir -p /data/openclaude/claude \
    /data/openclaude/npm-cache \
    /data/openclaude/pipx/bin \
    /data/openclaude/uv-cache \
    /data/workspace \
    /share/openclaude_workspace

if [[ -e /root/.claude && ! -L /root/.claude ]]; then
    bashio::log.warning "Moving existing /root/.claude into persistent storage"
    rm -rf /data/openclaude/claude
    mv /root/.claude /data/openclaude/claude
fi

if [[ ! -e /root/.claude ]]; then
    ln -s /data/openclaude/claude /root/.claude
fi

if bashio::config.has_value 'git_user_name'; then
    current_name=$(git config --file "${GIT_USER_PATH}/.gitconfig" user.name 2>/dev/null || true)
    if [[ -z "${current_name}" ]]; then
        name=$(bashio::config 'git_user_name')
        git config --file "${GIT_USER_PATH}/.gitconfig" user.name "${name}"
        if bashio::config.has_value 'git_user_email'; then
            email=$(bashio::config 'git_user_email')
            git config --file "${GIT_USER_PATH}/.gitconfig" user.email "${email}"
        fi
    fi
fi

provider=$(bashio::config 'default_provider')
model=$(bashio::config 'openai_model')
ollama_url=$(bashio::config 'ollama_base_url')
openrouter_url=$(bashio::config 'openrouter_base_url')

{
    echo "# Generated by OpenClaude Code Server add-on. Do not edit."
    echo "# Single-user root container; file is root-only."
    printf '%s\n' 'export PIPX_HOME=/data/openclaude/pipx'
    printf '%s\n' 'export PIPX_BIN_DIR=/data/openclaude/pipx/bin'
    printf '%s\n' 'export PATH="${PIPX_BIN_DIR}:${PATH}"'
    printf '%s\n' 'export NPM_CONFIG_CACHE=/data/openclaude/npm-cache'
    printf '%s\n' 'export UV_CACHE_DIR=/data/openclaude/uv-cache'
    printf '%s\n' 'export CLAUDE_CODE_USE_OPENAI=1'
    printf 'export OPENAI_MODEL=%q\n' "${model}"
} >"${PROFILE_FILE}"

if [[ "${provider}" == "openrouter" ]]; then
    printf 'export OPENAI_BASE_URL=%q\n' "${openrouter_url}" >>"${PROFILE_FILE}"
    if bashio::config.has_value 'openrouter_api_key'; then
        key=$(bashio::config 'openrouter_api_key')
        printf 'export OPENAI_API_KEY=%q\n' "${key}" >>"${PROFILE_FILE}"
    else
        bashio::log.warning "default_provider is openrouter but openrouter_api_key is empty"
    fi
else
    printf 'export OPENAI_BASE_URL=%q\n' "${ollama_url}" >>"${PROFILE_FILE}"
    if bashio::config.has_value 'ollama_api_key'; then
        okey=$(bashio::config 'ollama_api_key')
        printf 'export OPENAI_API_KEY=%q\n' "${okey}" >>"${PROFILE_FILE}"
    fi
fi

chmod 600 "${PROFILE_FILE}" || true

bashio::log.info "OpenClaude shell profile written to ${PROFILE_FILE}"
